<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-license-table" author="floxboard">
        <createTable tableName="license">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_license" nullable="false"/>
            </column>
            <column name="owner_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="license_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="plan_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="features" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="quotas" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="valid_until" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="license" indexName="idx_license_owner_id">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-quota-usage-ledger" author="floxboard">
        <createTable tableName="quota_usage_event">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_quota_usage_event" nullable="false"/>
            </column>
            <column name="owner_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="metric_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="units_consumed" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="VARCHAR(100)"/>
            <column name="metadata" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="quota_usage_event" indexName="idx_quota_usage_owner_metric_date">
            <column name="owner_id"/>
            <column name="metric_key"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
