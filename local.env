# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=floxboard
POSTGRES_USER=floxboard
POSTGRES_PASSWORD=floxboard

# Keycloak Configuration
KEYCLOAK_PORT=8090
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=quarkus
KEYCLOAK_CLIENT_ID=flox-backend
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_SERVER_URL=http://localhost:8090

# Mailpit & SMTP Configuration
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=floxBoard <no-reply@floxboard.io>
# For authenticated remote SMTP (e.g. SendGrid, Mailgun, AWS SES, Office 365):
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-api-key
# SMTP_STARTTLS=REQUIRED
# SMTP_AUTH_METHODS=PLAIN LOGIN
